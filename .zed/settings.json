{
  "file_scan_exclusions": [
    "**/.git",
    "**/.blackwall",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/target",
    "**/node_modules",
    "**/.venv",
    "**/venv"
  ],
  "languages": {
    "Rust": {
      "enable_language_server": true,
      "formatter": "auto",
      "format_on_save": "off"
    }
  },
  "lsp": {
    "rust-analyzer": {
      "enable_lsp_tasks": false,
      "initialization_options": {
        "checkOnSave": false,
        "cargo": {
          "noDeps": true,
          "allTargets": false,
          "buildScripts": {
            "enable": false
          }
        },
        "check": {
          "workspace": false
        },
        "rust": {
          "analyzerTargetDir": true
        },
        "files": {
          "exclude": [
            "target",
            "vendor"
          ]
        },
        "lru": {
          "capacity": 32
        },
        "cachePriming": {
          "enable": false,
          "numThreads": 1
        },
        "procMacro": {
          "enable": false
        },
        "numThreads": 2
      }
    }
  }
}
